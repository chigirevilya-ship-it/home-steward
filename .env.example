# Copy this file to .env and fill in your values. .env is gitignored — never
# commit real tokens.

# From Cloudflare Zero Trust dashboard → Networks → Tunnels → (your tunnel)
# → the install command shown there contains this token.
TUNNEL_TOKEN=

# 1 once the app is only reachable over HTTPS (behind the tunnel). Leave
# unset/0 for local http://<nas-ip>:8710 testing.
COOKIE_SECURE=1

# Optional — Anthropic API key for AI suggestions (system/equipment
# descriptions + maintenance schedules). Get one at console.anthropic.com.
# Leave empty to use the built-in rule-library suggestions instead.
ANTHROPIC_API_KEY=
